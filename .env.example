# BIS AI Intelligent Assistant Configuration
# Copy this file to .env and configure as needed.

# Application Environment (development / production)
ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite / PostgreSQL Database URL
DATABASE_URL=sqlite:///./data/bis_assistant.db

# LLM Providers (Optional for online synthesis; system includes offline deterministic fallback)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ChromaDB Collection
CHROMA_COLLECTION=bis_standards_kb

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=20

# Evaluator / Admin Telemetry Authentication (Configurable via environment variables)
# Set your secure credentials for production deployment
ADMIN_USERNAME=evaluator
ADMIN_PASSWORD=your_secure_evaluator_password_here
SESSION_SECRET=your_random_session_secret_key_here
