# BIS AI Intelligent Assistant Configuration
# Copy this file to .env and configure as needed.

# Application Environment (development / production)
ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite / PostgreSQL Database URL
DATABASE_URL=sqlite:///./data/bis_assistant.db

# Application Resource & Memory Modes
# APP_MODE: 'demo' (lightweight, zero model preloading, <=185MB RAM) or 'full'
APP_MODE=demo

# EMBEDDING_MODE: 'lightweight' (BM25 + structured matching, <=185MB RAM), 'lazy' (on-demand), or 'full'
EMBEDDING_MODE=lightweight

# LLM Provider: 'offline' (deterministic fast synthesis), 'gemini', 'groq', 'openai'
LLM_PROVIDER=offline

# External LLM Provider API Keys (Optional; required only if LLM_PROVIDER is set to gemini/groq/openai)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ChromaDB Collection
CHROMA_COLLECTION=bis_standards_kb

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=20

# Evaluator / Admin Telemetry Authentication (Configurable via environment variables)
# Set your secure credentials for production deployment
ADMIN_USERNAME=evaluator
ADMIN_PASSWORD=your_secure_evaluator_password_here
SESSION_SECRET=your_random_session_secret_key_here
